{
  "name": "@deepseek-ai/dsh-experimental-genesis",
  "version": "0.2.1-rc.2",
  "description": "Persistent life identity, sourced memories and observed capability history for Genesis.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/status-types.d.ts",
      "default": "./lib/types/status-types.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "cordis.memory.patch.yml",
    "cordis.emotion.patch.yml",
    "cordis.interest.patch.yml",
    "cordis.deliberation.patch.yml",
    "cordis.life.patch.yml",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
